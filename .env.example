# Supabase local hoặc Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Khóa công khai anon, dùng được ở browser và server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL gốc của ứng dụng, dùng để tạo liên kết xác thực.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role chỉ dùng server-side khi thật sự cần. Không import vào Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Chỉ dùng khi chạy seed Admin local.
LOCAL_ADMIN_EMAIL=admin@example.test
LOCAL_ADMIN_PASSWORD=LocalAdmin123!

# Google OAuth credentials (dùng cho Supabase Auth Google Provider)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

